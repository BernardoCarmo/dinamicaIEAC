# Copie este arquivo para ".env" e preencha com as chaves do SEU projeto Firebase
# (Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration).
# O ".env" nunca deve ser commitado (já está no .gitignore) — mas como este app não
# tem login/senha real de usuário, essas chaves não são secretas por natureza; ainda
# assim, evite publicar o database URL de produção em locais públicos sem necessidade.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deixe "true" apenas durante o desenvolvimento local com o emulador do Firebase
# (npm run emulators). Em produção (build para o GitHub Pages) deixe "false" ou
# remova esta linha.
VITE_USE_FIREBASE_EMULATOR=false
